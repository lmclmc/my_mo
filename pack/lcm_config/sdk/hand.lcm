package magic.hand;

/**
 * @brief 单个手部关节的控制命令
 */
struct single_hand_joint_command_t
{
    // 关节数量
    int32_t num_joints;  
    // 控制字  
    int16_t operation_mode; 
    // 期望位置
    float pos[num_joints];           
}

/**
 * @brief 整个手部控制命令
 */
struct hand_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;     
    // 所有手部关节的控制命令                  
    single_hand_joint_command_t cmd[2];      
}

/**
 * @brief 单个手部关节的状态
 */
struct single_hand_joint_state_t
{
    // 关节数量
    int32_t num_joints;  
    // 实际位置  
    float pos[num_joints]; 
    // 实际力矩    
    float toq[num_joints];  
    // 实际电流   
    float cur[num_joints];
    // 错误码     
    int16_t error_code; 
    // 状态字
    int16_t status_word;   
}

/**
 * @brief 整个手部状态信息
 */
struct hand_state_t
{
    // 时间戳（纳秒）
    int64_t timestamp;               
    // 所有手部关节状态           
    single_hand_joint_state_t state[2];         
}