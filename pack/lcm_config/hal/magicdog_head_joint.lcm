package hal.magichead;

/**
 * @brief 整个头部关节控制命令
 */
struct joint_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;
    // 关节数量        
    int32_t num_joints;   
    // 多个关节的状态集合
    hal.joint.single_joint_command_t joints[num_joints];   
}

/**
 * @brief 整个头部关节状态数据
 */
struct joint_state_t
{
    // 时间戳（纳秒）
    int64_t timestamp;
    // 关节数量        
    int32_t num_joints;                   
    // 多个关节的状态集合
    hal.joint.single_joint_state_t joints[num_joints];  
}