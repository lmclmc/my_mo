package hal.leg;

/**
 * @brief 整个腿部关节控制命令
 */
struct joint_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;    
    // 多个关节的状态集合，关节顺序：左腿6关节、右腿6关节               
    hal.joint.single_joint_command_t joints[12];   
}

/**
 * @brief 整个腿部关节状态数据
 */
struct joint_state_t
{
    // 时间戳（纳秒）
    int64_t timestamp;                
    // 多个关节的状态集合，关节顺序：左腿6关节、右腿6关节
    hal.joint.single_joint_state_t joints[12];  
}