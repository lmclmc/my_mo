package hal.arm;

/**
 * @brief 整个上臂关节控制命令
 */
struct joint_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;    
    // 多个关节的状态集合，关节顺序：左臂7关节、右臂7关节               
    hal.joint.single_joint_command_t joints[14];   
}

/**
 * @brief 整个上臂关节状态数据
 */
struct joint_state_t
{
    // 时间戳（纳秒）
    int64_t timestamp;                
    // 多个关节的状态集合，关节顺序：左臂7关节、右臂7关节   
    hal.joint.single_joint_state_t joints[14];  
}