struct ecat_debug_canfd_cmd_lcmt {
    int32_t     dim;            
    int8_t      canPort[dim];   // 传输can口
    int8_t      canId[dim];     // 传输can节点
    int8_t      cmdWord[dim];   // 指令控制字
    int8_t      cmdArgs[dim];   // 指令参数
    int8_t      cmdPara[dim];   // 指令配置
    int8_t      cmdAccu[dim];   // 指令精度
    float       tarPos[dim];
    float       tarVel[dim];
    float       tarTor[dim];
    int16_t     kp[dim];
    int16_t     kd[dim];
    int16_t     reserved[dim]; 
}