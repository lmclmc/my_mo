package manipulation.hand;

/**
 * @brief 单个手部关节的控制命令
 */
struct single_hand_joint_command_t
{
    // 关节数量 默认6
    int32_t num_joints;
    // 控制字 0->4: 启动
    int16_t operation_mode;
    // 期望关节顺序：小指、无名指、中指、食指、大拇指弯曲、大拇指内外旋转
    // 期望关节位置, 单位：弧度
    // 小指、无名指、中指、食指弯曲范围：[0, 1.413]
    // 大拇指弯曲范围：[0, 1.570]，大拇指内外旋转范围：[0, 1.029]
    float pos[num_joints];
}

/**
 * @brief 整个手部控制命令
 */
struct hand_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;
    // 所有手部关节的控制命令 左手、右手       
    single_hand_joint_command_t cmd[2];
}

/**
 * @brief 单个手部关节的状态
 */
struct single_hand_joint_state_t
{
    // 关节数量
    int32_t num_joints;
    // 实际关节顺序：小指、无名指、中指、食指、大拇指弯曲、大拇指内外旋转
    // 实际关节位置, 单位：弧度
    // 小指、无名指、中指、食指弯曲范围：[0, 1.413]
    // 大拇指弯曲范围：[0, 1.570]，大拇指内外旋转范围：[0, 1.029]
    float pos[num_joints];
    // 实际力矩 Nm
    float toq[num_joints];
    // 实际电流 A
    float cur[num_joints];
    // X向力均值，单位N（idx 6为侧摆无力值）
    float cur_touch_x[num_joints];
    // y向力均值，单位N（idx 6为侧摆无力值）
    float cur_touch_y[num_joints];
    // z向力均值，单位N（idx 6为侧摆无力值）
    float cur_touch_z[num_joints];
    // TOF数据 单位mm（idx 6为侧摆无力值）
    float tof[num_joints];
    // 错误码 
    int32_t error_code[num_joints];
    // 状态字
    int16_t status_word[num_joints];
}

/**
 * @brief 整个手部状态信息
 */
struct hand_state_t
{
    // 时间戳（纳秒）
    int64_t timestamp;           
    // 所有手部关节状态 左手、右手
    single_hand_joint_state_t state[2]; 
    // 灵巧手类型:0代表自研灵巧手，1代表强脑灵巧手
    int16_t type;
}