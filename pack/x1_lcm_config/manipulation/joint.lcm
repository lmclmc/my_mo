package manipulation.joint;

/**
 * @brief 单个关节的控制命令
 */
struct single_joint_command_t
{
    // 工作模式 3 混合控制 4 串联控制（默认） 5 ADRC
    int16_t operation_mode;
    // 目标位置 rad
    float pos;
    // 目标速度 rad/s
    float vel;
    // 目标力矩 Nm
    float toq;
    // 位置增益
    float kp;
    // 速度增益
    float kd;
}

/**
 * @brief 关节控制指令参数
 */
struct command_para_t
{
    // 控制模式 0 透传，不做插值 1 movej 2 movel 3 movec
    int32_t motion_mode;
    // 通信模式 1 与rbctrl通信 2 与HAL层通信
    int32_t com_mode;
}
 
/**
 * @brief 关节控制命令,适用于上臂、腿部、腰部和头部的关节指令
 */
struct joint_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;
    // 指令参数
    command_para_t para;
    // 关节数量
    int32_t num_joints;
    // 多个关节的状态集合，手臂关节顺序：左臂7关节、右臂7关节，腰部关节顺序：腰部3关节，头部关节顺序：头部2关节
    single_joint_command_t joints[num_joints];
}

/**
 * @brief 单个关节的状态
 */
struct single_joint_state_t
{
    // 状态字 3 混合控制 4 串联控制 5 ADRC
    int16_t status_word;
    // 当前关节位置, 高编 rad
    float posH;
    // 当前关节位置，低编 rad
    float posL;
    // 当前速度 rad/s
    float vel;
    // 当前力矩 Nm
    float toq;  
    // 当前电流 A
    float current; 
    // 错误码
    int16_t err_code;
}

/**
 * @brief 整个本体关节状态数据
 */
struct joint_state_t
{
    // 时间戳（纳秒）
    int64_t timestamp;     
    // 关节数量  
    int32_t num_joints;
    // 多个关节的状态集合，手臂关节顺序：左臂7关节、右臂7关节，腰部关节顺序：腰部3关节，头部关节顺序：头部2关节      
    single_joint_state_t joints[num_joints];
}
