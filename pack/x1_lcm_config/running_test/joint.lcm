package running_test.joint;

/**
 * @brief 单个关节的控制命令
 */
struct single_joint_command_t
{
    // 工作模式
    int16_t operation_mode; 
    // 目标位置
    float pos;     
    // 目标速度
    float vel;     
    // 目标力矩
    float toq;     
    // 位置增益
    float kp;      
    // 速度增益
    float kd;      
}

/**
 * @brief 整个本体关节控制命令
 */
struct joint_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;     
    // 关节数量              
    int32_t num_joints;  
    // 多个关节的状态集合，手臂关节顺序：左臂7关节、右臂7关节，腿部关节顺序：左腿6关节、右腿6关节，腰部关节顺序：腰部3关节，头部关节顺序：头部2关节                
    single_joint_command_t joints[num_joints];   
}

/**
 * @brief 整个本体关节到电机控制命令
 */
struct joint2motor_command_t
{
    // 时间戳（纳秒）
    int64_t timestamp;     
    // 关节数量              
    int32_t num_joints;  
    // 多个关节的状态集合，手臂关节顺序：左臂7关节、右臂7关节，腿部关节顺序：左腿6关节、右腿6关节，腰部关节顺序：腰部3关节，头部关节顺序：头部2关节                
    single_joint_command_t joints[num_joints];   
}

/**
 * @brief 单个关节的状态
 */
struct single_joint_state_t
{
    // 当前关节状态
    int16_t status_word;  
    // 当前关节位置, 高编
    float posH;     
    // 当前关节位置，低编
    float posL;     
    // 当前速度
    float vel;     
    // 当前力矩
    float toq;     
    // 当前电流
    float current;     
    // 错误码
    int32_t err_code; 
}

/**
 * @brief 整个本体关节状态数据
 */
struct joint_state_t
{
    // 时间戳（纳秒）
    int64_t timestamp;        
    // 关节数量        
    int32_t num_joints;                  
    // 多个关节的状态集合，手臂关节顺序：左臂7关节、右臂7关节，腿部关节顺序：左腿6关节、右腿6关节，腰部关节顺序：腰部3关节，头部关节顺序：头部2关节
    single_joint_state_t joints[num_joints]; 
}