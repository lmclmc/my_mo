struct dem_entry_lcmt {
  int64_t dtc_key;

  byte source;
  byte severity;
  byte status;

  byte vendor_id;
  byte module_id;
  byte type_id;
  byte component_id;
  byte object_id;
  int32_t code_id;

  int64_t legacy_code;

  int64_t first_timestamp_ns;
  int64_t last_timestamp_ns;

  int32_t fail_count;
  int32_t pass_count;

  byte confirmed;
  byte active;
}

struct dem_data_lcmt {
  int64_t timestamp;
  int64_t seq_num;

  int32_t dem_entry_count;
  dem_entry_lcmt dem_entries[dem_entry_count];
}
