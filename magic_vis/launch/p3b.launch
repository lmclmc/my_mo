<launch>
  
  <!-- Upload URDF file to ros parameter server for rviz to find  -->
  <param name="rviz_urdf_robot_description" command="$(find xacro)/xacro '$(find magic_vis)/urdf/p3_humanoid.urdf'"/>
  
  <!-- Publish TFs --> 
  <node name="p3b_urdf_visualizer" pkg="magic_vis" type="node_p3b_vis" output="screen"/>
   
</launch>
