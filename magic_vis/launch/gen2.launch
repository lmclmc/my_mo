<launch>
  
  <!-- Upload URDF file to ros parameter server for rviz to find  -->
  <param name="rviz_urdf_robot_description" command="$(find xacro)/xacro '$(find magic_vis)/urdf/gen2_v2.urdf'"/>
  
  <!-- Publish TFs --> 
  <node name="gen2_urdf_visualizer" pkg="magic_vis" type="node_gen2_vis" output="screen"/>
   
</launch>
