   <item>
    <widget class="QGroupBox" name="connectionGroup">
     <property name="title"><string>DDS 连接</string></property>
     <layout class="QGridLayout" name="connectionLayout">
      <item row="0" column="0"><widget class="QLabel" name="domainIdLabel"><property name="text"><string>Domain ID</string></property><property name="buddy"><cstring>domainIdSpinBox</cstring></property></widget></item>
      <item row="0" column="1"><widget class="QSpinBox" name="domainIdSpinBox"><property name="maximum"><number>232</number></property><property name="value"><number>200</number></property><property name="keyboardTracking"><bool>false</bool></property><property name="toolTip"><string>切换 Domain ID 后自动重新发现该域内的端点。</string></property></widget></item>
      <item row="0" column="2"><widget class="QLabel" name="partitionLabel"><property name="text"><string>订阅 Partition</string></property><property name="buddy"><cstring>partitionEdit</cstring></property></widget></item>
      <item row="0" column="3"><widget class="QLineEdit" name="partitionEdit"><property name="placeholderText"><string>留空使用默认分区，也可点击下方发现的分区</string></property><property name="minimumSize"><size><width>360</width><height>0</height></size></property></widget></item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="qosGroup">
     <property name="title"><string>订阅 QoS</string></property>
     <layout class="QGridLayout" name="qosLayout">
      <item row="0" column="0"><widget class="QLabel" name="reliabilityLabel"><property name="text"><string>Reliability · 可靠性</string></property></widget></item>
      <item row="0" column="1"><widget class="QComboBox" name="reliabilityComboBox"/></item>
      <item row="0" column="2"><widget class="QLabel" name="durabilityLabel"><property name="text"><string>Durability · 持久性</string></property></widget></item>
      <item row="0" column="3"><widget class="QComboBox" name="durabilityComboBox"/></item>
      <item row="0" column="4"><widget class="QLabel" name="historyLabel"><property name="text"><string>History · 历史策略</string></property></widget></item>
      <item row="0" column="5"><widget class="QComboBox" name="historyComboBox"/></item>
      <item row="1" column="0"><widget class="QLabel" name="historyDepthLabel"><property name="text"><string>History depth · 深度</string></property></widget></item>
      <item row="1" column="1"><widget class="QSpinBox" name="historyDepthSpinBox"><property name="minimum"><number>1</number></property><property name="maximum"><number>100000</number></property><property name="value"><number>1</number></property></widget></item>
      <item row="1" column="2"><widget class="QLabel" name="blockingTimeLabel"><property name="text"><string>最大阻塞时间</string></property></widget></item>
      <item row="1" column="3"><widget class="QSpinBox" name="blockingTimeSpinBox"><property name="suffix"><string> ms</string></property><property name="maximum"><number>60000</number></property><property name="value"><number>100</number></property></widget></item>
     </layout>
    </widget>
