   <item>
    <widget class="QGroupBox" name="recordingGroup">
     <property name="title"><string>MCAP / CDR 数据录制 · 滚动覆盖</string></property>
     <layout class="QGridLayout" name="recordingLayout">
      <item row="0" column="0"><widget class="QCheckBox" name="recordingEnabledCheckBox"><property name="text"><string>连接后录制</string></property><property name="toolTip"><string>保存选中话题的有效 CDR 样本及 IDL 类型描述。停止订阅时结束录制并写完缓存。</string></property></widget></item>
      <item row="0" column="1"><widget class="QLabel" name="recordingDirectoryLabel"><property name="text"><string>录制目录</string></property><property name="buddy"><cstring>recordingDirectoryEdit</cstring></property></widget></item>
      <item row="0" column="2" colspan="4"><widget class="QLineEdit" name="recordingDirectoryEdit"><property name="enabled"><bool>false</bool></property><property name="placeholderText"><string>输入目录或点击右侧选择；不存在的目录会自动创建</string></property><property name="toolTip"><string>同一目录中的 cyclonedds_record_XXXXXX.mcap 文件属于同一个滚动录制集合，旧文件可能被覆盖。</string></property></widget></item>
      <item row="0" column="6"><widget class="QPushButton" name="recordingDirectoryButton"><property name="enabled"><bool>false</bool></property><property name="text"><string>选择目录…</string></property></widget></item>
      <item row="1" column="0"><widget class="QLabel" name="recordingFileSizeLabel"><property name="text"><string>单文件最大大小</string></property><property name="buddy"><cstring>recordingFileSizeSpinBox</cstring></property></widget></item>
      <item row="1" column="1"><widget class="QSpinBox" name="recordingFileSizeSpinBox"><property name="enabled"><bool>false</bool></property><property name="minimum"><number>1</number></property><property name="maximum"><number>1048576</number></property><property name="value"><number>128</number></property><property name="suffix"><string> MB</string></property><property name="keyboardTracking"><bool>false</bool></property><property name="toolTip"><string>1 MB = 1024 × 1024 字节，包含 MCAP 文件头、消息、统计和文件尾。完整样本超出剩余容量时提前切换文件。</string></property></widget></item>
      <item row="1" column="2"><widget class="QLabel" name="recordingFileCountLabel"><property name="text"><string>最多录制文件数</string></property><property name="buddy"><cstring>recordingFileCountSpinBox</cstring></property></widget></item>
      <item row="1" column="3"><widget class="QSpinBox" name="recordingFileCountSpinBox"><property name="enabled"><bool>false</bool></property><property name="minimum"><number>1</number></property><property name="maximum"><number>10000</number></property><property name="value"><number>10</number></property><property name="suffix"><string> 个</string></property><property name="keyboardTracking"><bool>false</bool></property></widget></item>
      <item row="1" column="4" colspan="3"><widget class="QLabel" name="recordingFormatLabel"><property name="text"><string>格式：MCAP / CDR · 包含 IDL 类型描述</string></property></widget></item>
      <item row="2" column="0" colspan="7"><widget class="QLabel" name="recordingStatusLabel"><property name="text"><string>勾选后随连接开始录制。MCAP 保存所选话题的 CDR 数据、IDL 类型描述和上位机接收时间；1 MB = 1024 × 1024 字节。</string></property><property name="wordWrap"><bool>true</bool></property><property name="textFormat"><enum>Qt::PlainText</enum></property></widget></item>
     </layout>
    </widget>
