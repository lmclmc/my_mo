     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="childrenCollapsible"><bool>false</bool></property>
     <widget class="QGroupBox" name="partitionGroup">
      <property name="title"><string>Partition 分区发现</string></property>
      <property name="minimumSize"><size><width>240</width><height>200</height></size></property>
      <property name="maximumSize"><size><width>320</width><height>16777215</height></size></property>
      <property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property>
      <layout class="QVBoxLayout" name="partitionLayout">
       <item><widget class="QLabel" name="partitionCountLabel"><property name="text"><string>0 个分区</string></property></widget></item>
       <item><widget class="QTableWidget" name="partitionTableWidget"><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property><property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property><property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property><property name="alternatingRowColors"><bool>true</bool></property><property name="sortingEnabled"><bool>true</bool></property><attribute name="verticalHeaderVisible"><bool>false</bool></attribute><attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute></widget></item>
       <item><widget class="QLabel" name="partitionHintLabel"><property name="text"><string>点击分区后在右侧选择话题。切换 Domain 或分区会清空话题选择；空名称显示为“默认分区”。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
      </layout>
     </widget>
     <widget class="QGroupBox" name="topicGroup">
      <property name="title"><string>Topic 话题发现与订阅选择</string></property>
      <property name="minimumSize"><size><width>880</width><height>200</height></size></property>
      <property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>1</horstretch><verstretch>1</verstretch></sizepolicy></property>
      <layout class="QVBoxLayout" name="topicLayout">
       <item>
        <layout class="QHBoxLayout" name="topicSelectionLayout">
         <item><widget class="QLabel" name="topicCountLabel"><property name="text"><string>当前分区发现 0 个话题 · 已选 0 个</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
         <item><spacer name="topicSelectionSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
         <item><widget class="QPushButton" name="selectAllTopicsButton"><property name="text"><string>全选</string></property><property name="toolTip"><string>选中当前分区已发现的话题；后续新出现的话题需手动选择。</string></property></widget></item>
         <item><widget class="QPushButton" name="clearTopicsButton"><property name="text"><string>清空</string></property></widget></item>
        </layout>
       </item>
       <item><widget class="QTableWidget" name="topicTableWidget"><property name="editTriggers"><set>QAbstractItemView::NoEditTriggers</set></property><property name="selectionMode"><enum>QAbstractItemView::MultiSelection</enum></property><property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property><property name="toolTip"><string>单击一行选择或取消，可选择多个话题。高亮行表示将要订阅的话题。</string></property><property name="alternatingRowColors"><bool>true</bool></property><property name="sortingEnabled"><bool>true</bool></property><attribute name="verticalHeaderVisible"><bool>false</bool></attribute><attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute></widget></item>
       <item><widget class="QLabel" name="topicHintLabel"><property name="text"><string>单击选择或取消（可多选），高亮行将被订阅。XTypes 列绿色标记表示 IDL 已匹配，黄色标记表示部分类型已匹配；右侧 IDL 文件路径列显示对应文件，悬停查看完整路径与类型对应关系。Complete 可直接解析；其余话题可导入匹配的 IDL 后连接。</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>
       <item>
        <layout class="QHBoxLayout" name="idlImportLayout">
         <item><widget class="QPushButton" name="importIdlButton"><property name="text"><string>导入 IDL…</string></property><property name="toolTip"><string>导入与发布端消息定义一致的 IDL；按 DDS 类型名自动匹配，可导入多个文件。</string></property></widget></item>
         <item><widget class="QPushButton" name="clearIdlButton"><property name="text"><string>清除 IDL</string></property><property name="toolTip"><string>清除所有本地 IDL 定义，继续使用在线 XTypes 类型发现。</string></property></widget></item>
         <item><spacer name="idlImportSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
        </layout>
       </item>
       <item><widget class="QPlainTextEdit" name="idlStatusText"><property name="minimumSize"><size><width>0</width><height>65</height></size></property><property name="maximumSize"><size><width>16777215</width><height>90</height></size></property><property name="readOnly"><bool>true</bool></property><property name="plainText"><string>未导入 IDL。缺少完整 XTypes 信息的话题可通过 IDL 解析。</string></property></widget></item>
      </layout>
     </widget>
    </widget>
   </item>
