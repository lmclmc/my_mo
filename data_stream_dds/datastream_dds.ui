     <item><spacer name="discoveryHeaderSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property></spacer></item>
     <item><widget class="QPushButton" name="refreshDiscoveryButton"><property name="text"><string>重新发现</string></property><property name="toolTip"><string>清空当前发现列表，并重新监听所选 Domain。</string></property></widget></item>
