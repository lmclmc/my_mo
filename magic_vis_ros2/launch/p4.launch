<launch>
  
  <!-- Upload URDF file to ros parameter server for rviz to find  -->
  <param name="rviz_urdf_robot_description" command="$(find xacro)/xacro '$(find magic_vis_ros2)/urdf/p4_humanoid.urdf'"/>
  
  <!-- Publish TFs --> 
  <node name="p4_urdf_visualizer" pkg="magic_vis_ros2" type="node_p4_vis" output="screen"/>
   
</launch>
